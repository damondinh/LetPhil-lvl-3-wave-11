      "updated": 1795249813643,
      "created": 1795081217859,
      "link": null,
      "locked": false,
      "text": "SuggestProductForm.tsx\nimport type { ChangeEvent, FormEvent } from \"react\";\n    \ntype SuggestProductFormProps = {\n    categories: string[];\n}\n\nSuggestProductForm({categories}: SuggestProductFormProps) \n{\n    const [formData, setFormData] = useState<Suggestion>({name:\"\", category: categories[0] ?? \"\", reason:\"\"});\n    const [suggestions, setSuggestions] = useState<Suggestion[]>([]);\n    const [error, setError] = useState(\"\");\n\n    const handleChange = (e: ChangeEvent<HMTLInputElement|HTMLSelectElement|HTMLTextAreaElement>) \n    {\n        const {name,value} = e.target;\n        setFormData((currentForm) => ({ ...currentForm, [name]:value}));\n\n        // Clear the error message as soon as the user types\n        if (errors[name]) {\n          setErrors({ ...errors, [name]: '' });\n        }\n    };\n\n    const handleSubmit = (e: SubmitEvent<HTMLFormElement>) => {\n      e.preventDefault();\n    \n      // Validate required fields\n      if (!formData.name.trim() || !formData.reason.trim()) {\n        setError(\"Please fill out the product name and reason before submitting.\");\n        return;\n      }\n    \n      // Add suggestion to the list\n      setSuggestions((currentSuggestions) => [\n        ...currentSuggestions,\n        formData,\n      ]);\n    \n      // Clear the form\n      setFormData({\n        name: \"\",\n        category: categories[0] ?? \"\",\n        reason: \"\",\n      });\n    \n      // Clear validation error\n      setError(\"\");\n    };\n    \n    return(\n        <div>\n            // Heading            \n            <h3>HEADING</h3>\n\n            // Error\n            IF ERROR <p>{error}</p>\n            \n            // Form - input, select, textarea, reason.length/200\n            <form>\n                <div>\n                    <label htmlFor=\"name\"> Product Name </label>\n                    <input id=\"name\" value={formData.name} onChange={handleChange}/>\n                </div>\n                <div>\n                    <label htmlFor=\"category\"> Category </label>\n                    <select id=\"category\" value={formData.category} onChange={handleChange}>\n                        {categories.map((category) => (\n                            <option key={category} value={category}> \n                                {category[0].ToUpperCase() + category.slice(1)}\n                            </option>\n                        ))}\n                    </select>\n                </div>\n                <div>\n                    <label htmlFor=\"name\"> Product Name </label>\n                    <input id=\"name\" value={formData.name} onChange={handleChange}\n                </div>\n                <div>\n                    <textarea id=\"reason\" name=\"reason\" value={formData.reason} onChange={handleChange} maxLength={200} rows={4}\n                    <p>{formData.reason.length} / 200</p>\n                </div>\n\n                <button type=\"submit\"> Submit Suggestion</button>\n            </form>\n\n            // Suggestions\n            <h3>Suggestions ({suggestions.length})</h3>\n            {suggestions.map((suggestion, index) => (\n                <div key={index} className=\"flex flex-col\">\n                    <p>{suggestion.name}<span>suggestion.category</span></p>\n                    <p>{suggestion.reason}</p>\n                </div>\n            ))}\n        </div>\n    );\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "qJQIph1IMc5K7DtTtgGjG",
      "originalText": "SuggestProductForm.tsx\nimport type { ChangeEvent, FormEvent } from \"react\";\n    \ntype SuggestProductFormProps = {\n    categories: string[];\n}\n\nSuggestProductForm({categories}: SuggestProductFormProps) \n{\n    const [formData, setFormData] = useState<Suggestion>({name:\"\", category: categories[0] ?? \"\", reason:\"\"});\n    const [suggestions, setSuggestions] = useState<Suggestion[]>([]);\n    const [error, setError] = useState(\"\");\n\n    const handleChange = (e: ChangeEvent<HMTLInputElement|HTMLSelectElement|HTMLTextAreaElement>) \n    {\n        const {name,value} = e.target;\n        setFormData((currentForm) => ({ ...currentForm, [name]:value}));\n\n        // Clear the error message as soon as the user types\n        if (errors[name]) {\n          setErrors({ ...errors, [name]: '' });\n        }\n    };\n\n    const handleSubmit = (e: SubmitEvent<HTMLFormElement>) => {\n      e.preventDefault();\n    \n      // Validate required fields\n      if (!formData.name.trim() || !formData.reason.trim()) {\n        setError(\"Please fill out the product name and reason before submitting.\");\n        return;\n      }\n    \n      // Add suggestion to the list\n      setSuggestions((currentSuggestions) => [\n        ...currentSuggestions,\n        formData,\n      ]);\n    \n      // Clear the form\n      setFormData({\n        name: \"\",\n        category: categories[0] ?? \"\",\n        reason: \"\",\n      });\n    \n      // Clear validation error\n      setError(\"\");\n    };\n    \n    return(\n        <div>\n            // Heading            \n            <h3>HEADING</h3>\n\n            // Error\n            IF ERROR <p>{error}</p>\n            \n            // Form - input, select, textarea, reason.length/200\n            <form>\n                <div>\n                    <label htmlFor=\"name\"> Product Name </label>\n                    <input id=\"name\" value={formData.name} onChange={handleChange}/>\n                </div>\n                <div>\n                    <label htmlFor=\"category\"> Category </label>\n                    <select id=\"category\" value={formData.category} onChange={handleChange}>\n                        {categories.map((category) => (\n                            <option key={category} value={category}> \n                                {category[0].ToUpperCase() + category.slice(1)}\n                            </option>\n                        ))}\n                    </select>\n                </div>\n                <div>\n                    <label htmlFor=\"name\"> Product Name </label>\n                    <input id=\"name\" value={formData.name} onChange={handleChange}\n                </div>\n                <div>\n                    <textarea id=\"reason\" name=\"reason\" value={formData.reason} onChange={handleChange} maxLength={200} rows={4}\n                    <p>{formData.reason.length} / 200</p>\n                </div>\n\n                <button type=\"submit\"> Submit Suggestion</button>\n            </form>\n\n            // Suggestions\n            <h3>Suggestions ({suggestions.length})</h3>\n            {suggestions.map((suggestion, index) => (\n                <div key={index} className=\"flex flex-col\">\n                    <p>{suggestion.name}<span>suggestion.category</span></p>\n                    <p>{suggestion.reason}</p>\n                </div>\n            ))}\n        </div>\n    );\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
