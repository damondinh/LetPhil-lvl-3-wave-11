      "text": "App.tsx \nconst [products, setProducts] = useState<Product[]>([]);\n\nuseEffect(() => {\n    const fetchProducts = async () => {\n        const response = await fetch(\"https://dummyjson.com/products\");\n        const data: ProductsResponse = await response.json();\n        setProducts(data.products);\n    };\n    fetchProducts();\n},[]);",
